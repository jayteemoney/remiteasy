{
  "version": 2,
  "name": "remiteasy",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.walletconnect.com https://*.walletconnect.org; connect-src 'self' https://*.celo-sepolia.celo-testnet.org https://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org; img-src 'self' data: https://*.walletconnect.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "env": {
    "VITE_CONTRACT_ADDRESS": "0x6F491FaBdEc72fD14e9E014f50B2ffF61C508bf1",
    "VITE_RPC_URL": "https://forno.celo-sepolia.celo-testnet.org/",
    "VITE_CHAIN_ID": "11142220",
    "VITE_WALLETCONNECT_PROJECT_ID": "f7b45ad409e8ad7c23698264114cbe67"
  },
  "build": {
    "env": {
      "VITE_CONTRACT_ADDRESS": "0x6F491FaBdEc72fD14e9E014f50B2ffF61C508bf1",
      "VITE_RPC_URL": "https://forno.celo-sepolia.celo-testnet.org/",
      "VITE_CHAIN_ID": "11142220",
      "VITE_WALLETCONNECT_PROJECT_ID": "f7b45ad409e8ad7c23698264114cbe67"
    }
  },
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist"
}