# Deployed RemitEscrow Contract Address
# Get this from your deployment script output
VITE_CONTRACT_ADDRESS=0x6F491FaBdEc72fD14e9E014f50B2ffF61C508bf1

# Celo Sepolia RPC URL
# Use Forno (free public RPC) or your own node
VITE_RPC_URL=https://forno.celo-sepolia.celo-testnet.org/

# Chain ID for Celo Sepolia Testnet
VITE_CHAIN_ID=11142220

# WalletConnect Project ID
# Get from https://cloud.walletconnect.com/
# Required for WalletConnect functionality
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
